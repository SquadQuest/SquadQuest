#!/usr/bin/env bash
# Run SQL against this context's database, or open an interactive psql shell.
#
# Usage:
#   bin/db "SELECT count(*) FROM profile"
#   echo "SELECT 1" | bin/db
#   bin/db                       # interactive shell
#
# Env overrides: SQ_DATABASE, SQ_PG_PORT.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/_common.sh"

db="$(sq_db_name)"

if [ $# -gt 0 ]; then
  sq_psql -d "$db" -c "$1"
elif [ ! -t 0 ]; then
  sq_psql -d "$db"        # piped stdin
else
  docker exec -it "$SQ_CONTAINER_NAME" psql -U "$SQ_PG_USER" -d "$db"
fi
