<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  iOS OTA install manifest for the SquadQuest Dev ad-hoc build.
  CI stamps __BUILD_VERSION__ and publishes this + the signed IPA under
  https://v2.squadquest.app/downloads/. The IPA is co-hosted next to the manifest
  so the software-package URL is a direct, redirect-free HTTPS download (OTA
  install breaks on 302s). See specs/behaviors/ci-cd.md.
-->
<plist version="1.0">
<dict>
  <key>items</key>
  <array>
    <dict>
      <key>assets</key>
      <array>
        <dict>
          <key>kind</key>
          <string>software-package</string>
          <key>url</key>
          <string>https://v2.squadquest.app/downloads/squadquest-dev-latest.ipa</string>
        </dict>
        <dict>
          <key>kind</key>
          <string>display-image</string>
          <key>url</key>
          <string>https://v2.squadquest.app/icons/Icon-192.png</string>
        </dict>
        <dict>
          <key>kind</key>
          <string>full-size-image</string>
          <key>url</key>
          <string>https://v2.squadquest.app/icons/Icon-512.png</string>
        </dict>
      </array>
      <key>metadata</key>
      <dict>
        <key>bundle-identifier</key>
        <string>app.squadquest.dev</string>
        <key>bundle-version</key>
        <string>__BUILD_VERSION__</string>
        <key>kind</key>
        <string>software</string>
        <key>title</key>
        <string>SquadQuest Dev</string>
      </dict>
    </dict>
  </array>
</dict>
</plist>
