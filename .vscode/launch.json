{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "inputs": [
        {
            "id": "vmServiceUri",
            "type": "promptString",
            "description": "VM service URI (ask MCP for it)"
        }
    ],
    "configurations": [
        {
            "name": "Flutter: app",
            "type": "dart",
            "request": "launch",
            "cwd": "app",
            "program": "lib/main.dart"
        },
        {
            "name": "Flutter: Attach",
            "type": "dart",
            "request": "attach",
            "cwd": "app",
            "vmServiceUri": "${input:vmServiceUri}"
        },
        {
            "name": "Server: dev",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}/server",
            "runtimeExecutable": "bun",
            "runtimeArgs": ["--watch", "src/index.ts"],
            "outputCapture": "std"
        }
    ]
}
