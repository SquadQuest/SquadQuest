<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>

	<key>teamID</key>
	<string>64TVJXTLTT</string>

	<!--
	  Manual signing with an explicit profile per bundle id. Automatic signing
	  was tried first and fails here: with no App Store profiles on the account
	  (Xcode Cloud managed signing internally and never created any), export
	  falls back to cloud signing to mint them, which needs an Admin-role API
	  key. The CI key is deliberately only App Manager, so the profiles are
	  created once out of band and downloaded per build instead.

	  These names are referenced by name, not UUID, so regenerating a profile
	  -- after adding a device, or when it expires -- keeps this file valid.
	-->
	<key>signingStyle</key>
	<string>manual</string>

	<key>signingCertificate</key>
	<string>Apple Distribution</string>

	<key>provisioningProfiles</key>
	<dict>
		<key>app.squadquest</key>
		<string>SquadQuest App Store</string>
		<key>app.squadquest.ImageNotification</key>
		<string>SquadQuest ImageNotification App Store</string>
	</dict>

	<key>uploadSymbols</key>
	<true/>

	<!-- Write the .ipa to disk; the workflow uploads it as a separate step. -->
	<key>destination</key>
	<string>export</string>
</dict>
</plist>
